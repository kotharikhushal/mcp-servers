# Public https URL the service is published on (no trailing slash)
PUBLIC_URL=https://health.example.com
# Long random secret the phone app sends: openssl rand -hex 32
INGEST_TOKEN=
# Authelia (or any OIDC provider)
OIDC_ISSUER=https://auth.example.com
# Must equal PUBLIC_URL + /mcp: Claude asks for tokens for that resource
OIDC_AUDIENCE=https://health.example.com/mcp
OIDC_CLIENT_ID=health-mcp
OIDC_CLIENT_SECRET=
# Optional: only accept your own user id (the "sub" claim)
OIDC_ALLOWED_SUBJECTS=
TZ_NAME=Europe/London

# Mealie (optional): adds recipe, meal plan and "log this recipe" tools to the Health connector.
# Create the token in Mealie under User profile > API tokens. Use an address this container can reach.
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=

# Wellness web app (optional, off unless WEB_PUBLIC_URL is set). See the README.
# WEB_PUBLIC_URL=https://wellness.example.com
# WEB_OIDC_CLIENT_ID=wellness-web
# WEB_OIDC_CLIENT_SECRET=
# WEB_SESSION_SECRET=
# WEB_USERS=khushal:Khushal,shivani:Shivani
# WEB_DEFAULT_USER=khushal
# NTFY_BASE=https://ntfy.sh      # push notification server for reminders (use your own if you run one)

# Link each person to their Authelia sign-in (sub, username or email) so the Claude connector shows their own data.
# MCP_USERS=khushal:khushal@example.com,shivani:shivani@example.com

# Optional: local model for the Today page AI analysis (needs Ollama reachable from this container)
# OLLAMA_URL=http://192.168.0.202:9068
# OLLAMA_MODEL=gemma4:12b
