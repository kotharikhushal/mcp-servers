# Public https URL the service is published on (no trailing slash)
PUBLIC_URL=https://health.example.com
# Long random secret the phone app sends: openssl rand -hex 32
INGEST_TOKEN=
# Authelia (or any OIDC provider)
OIDC_ISSUER=https://auth.example.com
# Must equal PUBLIC_URL + /mcp: Claude asks for tokens for that resource
OIDC_AUDIENCE=https://health.example.com/mcp
OIDC_CLIENT_ID=health-mcp
OIDC_CLIENT_SECRET=
# Optional: only accept your own user id (the "sub" claim)
OIDC_ALLOWED_SUBJECTS=
TZ_NAME=Europe/London
